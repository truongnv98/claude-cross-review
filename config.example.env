# Copy to ~/.config/cross-review/config.env and edit. Every line is optional.

# Claude: use a separate config dir (e.g. a work account profile) instead of ~/.claude
# CLAUDE_HOME="$HOME/path/to/claude-config-dir"
# Refuse to run Claude unless it is logged in as this email
# CLAUDE_EXPECT_EMAIL="you@company.com"

# Models and effort
# CLAUDE_MODEL="claude-opus-5-5";   CLAUDE_EFFORT="medium"
# MERGE_MODEL="claude-sonnet-5-5";  MERGE_EFFORT="low"
# CODEX_MODEL="gpt-6.1-sol";        CODEX_EFFORT="medium"
# GEMINI_MODEL="gemini-4-neon-medium"   # see: agy models

# Timeouts per step
# REVIEW_TIMEOUT="45m"; MERGE_TIMEOUT="10m"; CHECK_TIMEOUT="20m"; DEBATE_TIMEOUT="15m"
